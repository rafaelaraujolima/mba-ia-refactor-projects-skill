@baseUrl = http://localhost:3000

### Login (admin seed)
POST {{baseUrl}}/api/login
Content-Type: application/json

{
  "email": "leonan@fullcycle.com.br",
  "password": "123"
}

### Checkout - sucesso
POST {{baseUrl}}/api/checkout
Content-Type: application/json

{
  "usr": "Guilherme",
  "eml": "gui@fullcycle.com.br",
  "pwd": "senhaforte",
